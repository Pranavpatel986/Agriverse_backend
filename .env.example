# Copy to .env (or export as real environment variables) for local development.
DB_URL=jdbc:postgresql://localhost:5432/agriverse
DB_USERNAME=agriverse
DB_PASSWORD=agriverse

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace-with-a-long-random-base64-string-at-least-32-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000

SERVER_PORT=8080
